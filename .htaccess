# Swami Vivekananda College of Education (SVCE)
# Apache URL Rewrite Rules for Clean URLs

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect /index.html to /home
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
  RewriteRule ^index\.html$ /home [R=301,L]

  # Map /home directly to index.html
  RewriteRule ^home/?$ index.html [L]

  # Remove .html extension from URL if directly requested
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^\ ]+)\.html\ HTTP/
  RewriteRule ^([^\ ]+)\.html$ /$1 [R=301,L]

  # Resolve extensionless clean URLs (e.g. /about -> about.html)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^([^\/]+)/?$ $1.html [L]
</IfModule>

# Security & Compression Headers
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>
